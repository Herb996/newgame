  "sprites_ts": {
    "_comment": "Tiny Swords Warrior（Blue 阵营）。官方单位是正面朝向的单向序列帧，四个方向共用同一套帧（素材本身就是正视视角，左右翻转反而别扭）。数组形式 = 四向共用，见 player_animator.gd 的 parse_spec。",
    "fps": {
      "idle": 8,
      "walk": 12,
      "attack": 12,
      "dodge": 16,
      "hit": 12,
      "dead": 8
    },
    "idle": [
      "res://Assets/Art/Sprites/Units/blue_warrior/idle_00.png",
      "res://Assets/Art/Sprites/Units/blue_warrior/idle_01.png",
      "res://Assets/Art/Sprites/Units/blue_warrior/idle_02.png",
